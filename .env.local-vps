# -----------------------------------------------------------------------------
# Local Fake VPS environment (Docker Compose)
# Copy this file to .env.local-vps and edit values for your VM.
# -----------------------------------------------------------------------------

# HTTP port exposed by Nginx on the VM.
# If 80 is already used, set 8080.
HTTP_PORT=8080

# PostgreSQL credentials used by both app and db container.
# Local testing values are OK here.
DB_NAME=full_house_copy
DB_USER=postgres
DB_PASSWORD=postgres

# Keep SSL disabled for local Docker network.
DB_SSLMODE=disable

# Public URL you will open from your main computer.
# Replace <VM_IP> with your Ubuntu VM LAN IP (example: 192.168.1.50).
STORE_URL=http://212.47.79.230:3000
STORE_NAME=Full House Local VPS

# Sender defaults (safe placeholders for local tests).
EMAIL_FROM=local@test.invalid
EMAIL_FROM_NAME=Full House Local
ADMIN_EMAIL=admin@local.test

# Optional SMTP/SendGrid variables.
# Keep empty in local fake VPS to prevent real email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_REPLY_TO_EMAIL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_REPLY_TO_EMAIL=

# JWT security secrets (REQUIRED for token auth paths).
# Use strong random values even in local VM.
JWT_ISSUER=fullhouse-local-vps
JWT_ADMIN_SECRET=YvoBwOe27UzsqzFHyQR6wqtxJKLbHqI3Pywjjcb3Lzd3Oe5G
JWT_ADMIN_REFRESH_SECRET=FLp3NFJXanrjaz6iXqs5wcUs604RynHrAG3mLWO3ckneXE7s
JWT_CUSTOMER_SECRET=fbu8vY4TED4w4sRY3PqIUgegogT8GAgr1PvcYPqhrMzbkTXL
JWT_CUSTOMER_REFRESH_SECRET=cpbqEmpXap03zUHQRpLqe6RHtiU484GrmRubfs4jkjQoS7Bf

# Token lifetimes (seconds). Defaults are fine for local tests.
JWT_ADMIN_TOKEN_EXPIRY=900
JWT_ADMIN_REFRESH_TOKEN_EXPIRY=54000
JWT_CUSTOMER_TOKEN_EXPIRY=1800
JWT_CUSTOMER_REFRESH_TOKEN_EXPIRY=108000

# Disable sensitive feature modules in local fake VPS.
# This is JSON consumed by extension moduleManager.
# - whatsappNotifications: avoids sending real WhatsApp order links
# - aiProductDescriptions: avoids real AI provider calls
CLIENT_FEATURES={"whatsappNotifications":false,"aiProductDescriptions":false}

# Keep AI keys empty for local fake VPS.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_DESCRIPTION_API_KEY=
AI_DESCRIPTION_MODEL=gpt-4o
AI_DESCRIPTION_BASE_URL=https://api.openai.com/v1

