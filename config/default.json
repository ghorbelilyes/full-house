{
  "shop": {
    "language": "fr-TN",
    "timezone": "Africa/Tunis",
    "currency": "TND",
    "weightUnit": "kg",
    "homeUrl": "http://localhost:3000"
  },
  "system": {
    "file_storage": "local",
    "extensions": [
      {
        "name": "languageSwitcher",
        "resolve": "extensions/languageSwitcher",
        "enabled": false,
        "priority": 10
      },
      {
        "name": "darkMode",
        "resolve": "extensions/darkMode",
        "enabled": false,
        "priority": 11
      },
      {
        "name": "dashboardAnalytics",
        "resolve": "extensions/dashboardAnalytics",
        "enabled": true,
        "priority": 12
      },
      {
        "name": "productPromotion",
        "resolve": "extensions/productPromotion",
        "enabled": true,
        "priority": 13
      }
    ],
    "session": {
      "maxAge": 86400000,
      "resave": false,
      "saveUninitialized": false
    }
  },
  "catalog": {
    "collectionPageSize": 20,
    "showOutOfStockProduct": false
  },
  "checkout": {
    "showShippingNote": true
  },
  "themeConfig": {
    "logo": {
      "alt": "Full House - Electricity & Security",
      "src": "/logo.png",
      "width": 320,
      "height": 80
    },
    "headTags": {
      "links": [
        { "rel": "icon", "href": "/favicon.ico", "type": "image/x-icon" },
        { "rel": "icon", "href": "/favicon-32x32.png", "type": "image/png", "sizes": "32x32" },
        { "rel": "icon", "href": "/favicon-16x16.png", "type": "image/png", "sizes": "16x16" },
        { "rel": "apple-touch-icon", "href": "/apple-touch-icon.png", "sizes": "180x180" }
      ],
      "metas": [
        { "name": "viewport", "content": "width=device-width, initial-scale=1" }
      ]
    },
    "copyRight": "© 2025 Full House - Electricity & Security. Tous droits réservés."
  },
  "pricing": {
    "rounding": "round",
    "precision": 2,
    "tax": {
      "rounding": "round",
      "precision": 2,
      "round_level": "total",
      "price_including_tax": true
    }
  }
}
